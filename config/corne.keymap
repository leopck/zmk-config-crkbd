#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            label = "Base";
            bindings = <
&kp TAB     &kp Q  &kp W  &kp E      &kp R         &kp T        &kp Y    &kp U  &kp I         &kp O    &kp P     &kp DEL
&kp ESCAPE  &kp A  &kp S  &kp D      &kp F         &kp G        &kp H    &kp J  &kp K         &kp L    &kp SEMI  &kp BACKSPACE
&kp LSHFT   &kp Z  &kp X  &kp C      &kp V         &kp B        &kp N    &kp M  &kp COMMA     &kp DOT  &kp FSLH  &mo 4
                          &kp LCTRL  &kp LEFT_ALT  &kp SPACE    &kp RET  &mo 1  &kp LEFT_WIN
            >;
        };

        Symbols {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            label = "Sym";
            bindings = <
&kp GRAVE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &trans     &trans     &trans        &kp LBKT         &kp RIGHT_BRACKET  &kp BACKSLASH
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp LEFT   &kp DOWN   &kp UP_ARROW  &kp RIGHT_ARROW  &kp SINGLE_QUOTE   &kp BACKSPACE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp COMMA     &kp PERIOD       &kp SLASH          &trans
                             &kp LGUI  &trans    &kp SPACE    &kp RET    &trans     &trans
            >;
        };

        numbers {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    |BTCLR|     | SPC |   | ENT |     | ALT |

            label = "Num";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5       &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &trans
&trans     &trans  &trans  &trans  &trans  &trans       &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &kp BACKSPACE
&kp LSHFT  &trans  &trans  &trans  &trans  &trans       &trans    &trans    &trans    &trans     &trans  &trans
                           &trans  &trans  &kp SPACE    &kp RET   &trans    &kp RALT
            >;
        };

        admin_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
&bootloader   &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans
                                          &trans        &trans        &trans        &trans  &trans  &trans
            >;

            label = "admin";
        };

        Fn {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5        &kp F6       &kp F7     &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans        &trans       &trans     &trans  &trans  &trans   &trans   &kp BSPC
&trans  &trans  &trans  &trans  &trans        &trans       &trans     &trans  &trans  &trans   &trans   &trans
                        &trans  &kp LEFT_ALT  &kp SPACE    &kp ENTER  &trans  &trans
            >;

            label = "Fn";
        };
    };
};
